make_mock_clustered_events_score <- function() {
data.frame(
cnv_equiv_id          = paste0("locus_", 1:5),
embryo                = c("E1", "E1", "E2", "E2", "E1"),
chr                   = c("chr1", "chr2", "chr1", "chr3", "chrX"),
cnv_state             = c("gain", "loss", "gain", "gain", "loss"),
arm_class             = c("p_arm", "q_arm", "p_centromere_q",
"q_arm", "p_arm"),
start                 = c(1e6,  5e6,  10e6, 20e6, 1e6),
end                   = c(31e6, 30e6, 60e6, 55e6, 6e6),
cnv_length            = c(30e6, 25e6, 50e6, 35e6, 5e6),
cnv_length_mb         = c(30.0, 25.0, 50.0, 35.0, 5.0),
n_cells               = c(10L,  3L,   8L,   6L,   5L),
n_total_cells         = c(100L, 100L, 400L, 400L, 100L),
whole_chromosome_gain = c(NA,   NA,   80,   NA,   NA),
whole_chromosome_loss = c(NA,   NA,   NA,   NA,   NA),
p_arm_pct             = c(NA,   NA,   75,   NA,   NA),
q_arm_pct             = c(NA,   NA,   72,   NA,   NA),
p_centromere_pct      = c(NA,   NA,   NA,   NA,   NA),
centromere_q_pct      = c(NA,   NA,   NA,   NA,   NA),
stringsAsFactors      = FALSE
)
}
