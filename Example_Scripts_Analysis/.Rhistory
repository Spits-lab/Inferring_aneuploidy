testthat::test_that("run_full_cnv_pipeline: block1 is NULL when starting from block2", {
tmp     <- file.path(tempdir(), paste0("test_block1_null_", Sys.getpid()))
workdir <- file.path(tempdir(), paste0("test_workdir_b1_", Sys.getpid()))
# Create within/ directory — but no cell type subdirectories
dir.create(file.path(tmp, "within"), recursive = TRUE, showWarnings = FALSE)
dir.create(workdir, showWarnings = FALSE)
meta_with_split <- make_mock_pipeline_metadata()
err <- tryCatch(
suppressMessages(
run_full_cnv_pipeline(
start_from  = "block2",
workdir     = workdir,
tool_outdir = tmp,
metadata    = meta_with_split
)
),
error = function(e) e
)
testthat::expect_false(grepl("counts_mx",      err$message))
testthat::expect_false(grepl("metadata required for block1", err$message))
# Should be a Block2 error about missing directories or cell types
testthat::expect_true(
grepl("Run Block 1 first", err$message)
)
unlink(c(tmp, workdir), recursive = TRUE)
})
